# --- Supabase (free tier project) ---
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Project Settings -> Database -> Connection string (use the "Session pooler" URI, transaction mode off)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Groq (free tier) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Redis (optional, free tier via Upstash) ---
# Caches document-retrieval results for a few minutes so repeated/near-
# duplicate questions skip re-embedding + re-searching. Safe to leave unset
# -- the app runs fine without it, just without this caching layer.
# Upstash (https://upstash.com) -> New database (free tier) -> copy the
# "Redis" connection string (starts with rediss://) shown on the DB page.
REDIS_URL=

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
