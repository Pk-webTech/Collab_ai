# --- Supabase (free tier project) ---
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Required: used when fetching the project's JWT signing keys (JWKS).
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: only needed for legacy HS256 projects.
SUPABASE_JWT_SECRET=
# Project Settings -> Database -> Connection string (use the "Session pooler" URI, transaction mode off)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Groq (free tier) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Main model: writes the replies users read.
GROQ_MODEL=llama-3.3-70b-versatile
# Small, fast model for background jobs (memory extraction). Leave blank to
# use GROQ_MODEL for everything. Check it's still served with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- Redis (optional, free tier via Upstash) ---
# Caches document-retrieval results for a few minutes so repeated/near-
# duplicate questions skip re-searching. Safe to leave unset -- the app
# runs fine without it. For lowest latency, create the Upstash database in
# the same region as the backend.
# Upstash (https://upstash.com) -> New database (free tier) -> copy the
# "Redis" connection string (starts with rediss://) shown on the DB page.
REDIS_URL=

# --- App ---
# Single local origin, or comma-separated for multiple (e.g. once you have
# a deployed frontend domain in addition to localhost). If FRONTEND_ORIGINS
# is set it takes priority over FRONTEND_ORIGIN.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=

# --- Observability ---
# DEBUG, INFO, WARNING, or ERROR. INFO logs one line per request, plus a
# `chat_timing` line per chat reply (prep_ms, first_token_ms, total_ms).
LOG_LEVEL=INFO

# --- Rate limits (requests per user per minute) ---
CHAT_RATE_LIMIT_PER_MINUTE=20
ROOM_MESSAGE_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
